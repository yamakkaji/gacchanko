      "mode": "request",
      "policy": "mutable"
    },
    {
      "id": "edge_07",
      "source": "agent",
      "target": "response",
      "sourcePort": "response",
      "targetPort": "text",
      "label": "最終応答",
      "intent": "最終テキストを渡して表示する。失敗時にはエラーを表示する。",
