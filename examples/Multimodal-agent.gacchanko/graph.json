      "mode": "data",
      "policy": "mutable"
    },
    {
      "id": "edge_02",
      "source": "audio",
      "target": "transcribe",
      "sourcePort": "audio",
      "targetPort": "audio",
      "label": "音声",
      "intent": "音声データとサンプルレートを渡す。形式を検証する。",
      "mode": "data",
      "policy": "mutable"
    },
    {
      "id": "edge_03",
      "source": "vision",
      "target": "agent",
      "sourcePort": "description",
      "targetPort": "image_context",
      "label": "画像の説明",
      "intent": "画像の説明をrequest_idとともに渡す。",
      "mode": "data",
      "policy": "mutable"
    },
    {
      "id": "edge_04",
      "source": "transcribe",
      "target": "agent",
      "sourcePort": "transcript",
      "targetPort": "audio_text",
      "label": "文字起こし",
      "intent": "認識したテキストをrequest_idとともに渡す。",
      "mode": "data",
      "policy": "mutable"
    },
    {
